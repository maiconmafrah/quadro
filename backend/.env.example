# Copie este arquivo para ".env" durante o desenvolvimento local (o backend
# carrega ".env" automaticamente via python-dotenv). Em produção, prefira
# definir estas variáveis diretamente no serviço systemd (veja o README.md).

# Chave que o frontend deve enviar em toda requisição. Escolha algo longo e aleatório.
ACCESS_KEY=troque-por-uma-chave-longa-e-aleatoria

# Origem exata (protocolo + domínio) de onde o frontend será servido no GitHub Pages.
# Exemplo: https://seu-usuario.github.io
FRONTEND_ORIGIN=https://seu-usuario.github.io

# Limites opcionais (valores padrão já mostrados abaixo)
MAX_DURATION_SECONDS=3600
MAX_FILESIZE_MB=500
EXTRACT_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=600

# Diretório temporário onde os vídeos ficam durante o download (apagado logo em seguida)
TEMP_DIR=/tmp/quadro-downloads
